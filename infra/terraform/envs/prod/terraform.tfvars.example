# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

region    = "us-east-1"
env       = "prod"
tenant_id = "respect-the-funk"

# The B2 bucket. Create it in the Backblaze console first — it is not managed here,
# because Terraform destroying a bucket that holds every master and every kit is a
# risk with no upside.
b2_bucket = "remixkit-prod"

# Who can sign in. Overrides the default in variables.tf. There is no sign-up — an
# address not on this list is refused before a code is sent. Put SESSION_SECRET and
# /resend/api-key in SSM before the first apply; see variables.tf for the two commands.
# allowed_emails = ["anthonybtedesco@gmail.com", "colleague@label.example"]
