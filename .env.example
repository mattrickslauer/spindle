# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Vertex AI, via an application-default login plus a project-scoped regional endpoint.
# See content/bin/vertex.py for why express-mode API keys no longer work.
#
#     gcloud auth application-default login
#
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# Legacy express-mode key. Kept because vertex.available() still falls back to it,
# but the ADC path above is the one that works.
AGENT_GCP_KEY=

# Optional: OpenAI, if you run generate_stills.py --provider openai
OPENAI_API_KEY=

# ------------------------------------------------------------- embeddings
#
# Which provider writes vectors. **Set this explicitly and leave it set.**
#
# `embed.load()` infers OpenAI when `OPENAI_API_KEY` is present and no choice is given,
# which was the right default when OpenAI was the only embedder that worked. Since the
# 2026-08-16 cutover it is a trap: the corpus is `bedrock:cohere.embed-english-v3`, and a
# worker started without this variable would quietly resume writing
# `openai:text-embedding-3-small` rows into it.
#
# That failure is close to invisible. It does not error and it does not corrupt anything —
# `embedding_model` is a prefix column of the `party_shortlist` vector index, so the two
# models can never be compared. What happens instead is that the index silently splits in
# two and every shortlist quietly returns only the half matching the artist's own model.
#
#   bedrock-cohere  cohere.embed-english-v3 on Bedrock — what the corpus is on now
#   openai          text-embedding-3-small — what it was on before
#   bedrock         on-demand Titan; quota on this account is a non-adjustable zero
#   bedrock-batch   Titan batch; the account is not entitled to CreateModelInvocationJob
RTF_EMBED_PROVIDER=bedrock-cohere

# ---------------------------------------------------------------- Stripe
#
# Four are required together: the key, the webhook secret, and the two price ids **for
# the mode the key selects**. `settings.stripe_configured` is false unless every one is
# set, and `POST /billing/checkout` then refuses naming exactly which are missing rather
# than creating a checkout that 404s at Stripe.
#
# The free tier needs none of these. Sign-in and the whole console work without
# Stripe entirely; only the two paid plans need it.
#
# The mode is read off the key's own prefix — sk_test_ or sk_live_ — so there is no
# second flag that could disagree with it, and the "test mode" badge in the UI cannot
# say one thing while a different ledger is charged. A key that is neither prefix is
# refused rather than assumed to be test.
#
# **A live key is accepted as of 2026-08-15.** `billing.py` refused one until then. That
# guard is gone deliberately and the module says what replaced it; the short version is
# that nothing now stands between this file and a real charge except which key you put
# in it. Switching a deployment to live is a change of STRIPE_SECRET_KEY alone, provided
# the _LIVE price ids below are already filled in.
#
# To fill these in:
#
#   1. STRIPE_SECRET_KEY — from the Stripe dashboard, test mode to start with
#   2. the two price ids — create them from the tiers rather than by hand, so the
#      amounts cannot drift from what plans.py enforces and the landing page renders:
#
#        cd apps/spindle/web
#        STRIPE_SECRET_KEY=sk_test_... .venv/bin/python ../bin/stripe_setup.py
#
#      It prints the ids to paste below. It is idempotent (prices are keyed by tier
#      and amount) and it never writes this file. Add --live with an sk_live_ key to
#      create the live pair; the flag and the key must agree, and either one alone is
#      refused.
#   3. STRIPE_WEBHOOK_SECRET — from the endpoint you point at POST /billing/webhook,
#      starts whsec_. An unset one refuses every webhook, which is correct: an
#      unverified billing webhook is an unauthenticated way to grant paid plans.
#      For local work, `stripe listen --forward-to localhost:8000/billing/webhook`
#      prints one. For a deployed endpoint, pass --webhook-url to stripe_setup.py —
#      Stripe reveals a signing secret only when the endpoint is created, so there is
#      no way to read it back afterwards.
#
#      A signing secret is per-endpoint. Do not reuse one from another project's
#      endpoint on the same Stripe account; verification will fail on both.
#
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Test ledger. Read only when STRIPE_SECRET_KEY starts sk_test_.
STRIPE_PRICE_LABEL=
STRIPE_PRICE_ROSTER=

# Live ledger. Read only when STRIPE_SECRET_KEY starts sk_live_. Both pairs can sit here
# at once and that is the point: the key picks the pair, so promoting a deployment does
# not mean hand-editing two opaque strings and hoping neither was missed.
STRIPE_PRICE_LABEL_LIVE=
STRIPE_PRICE_ROSTER_LIVE=

# ---------------------------------------------------------------------------
# RemixKit, merged up from apps/remixkit/.env.example on 2026-08-15, so that the
# template lives beside the file it is a template for. One .env, one .env.example.
# ---------------------------------------------------------------------------
# Copy to app/.env and fill in. .env is gitignored — never commit real values.
#
# Everything here is optional. With none of it set the console runs on a laptop with
# local storage, mocked generation, an inline queue, and no login — and says so in a
# banner on every page. Each variable below moves one axis to the real thing.

# ---------------------------------------------------------------- sign-in
# `none` (default) = AnonymousAuth, every caller is the default tenant, no login page.
# `otp`            = email a six-digit code, exchange it for a signed session.
RK_AUTH_BACKEND=none

# This IS the user table. Comma-separated; there is no registration. An address not on
# this list is refused at request time, at verify time, and on every session read — so
# removing someone ends their session at their next request.
RK_ALLOWED_EMAILS=

# Signs sessions and hashes OTP codes. Generate with:
#     python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave empty on a laptop and a random one is used per process, which logs everyone out
# on restart. RK_REQUIRE_AUTH=true refuses to start rather than doing that.
RK_SESSION_SECRET=

# ---------------------------------------------------------------- mail
# `console` (default) logs the code instead of sending it, so the flow is completable
# with no credentials. In RK_ENV=dev the code is also returned to the caller — both
# conditions are required, because either alone would be an auth bypass.
RK_MAIL_BACKEND=console

# Resend (RK_MAIL_BACKEND=resend). In a deployment the key comes from the shared SSM
# parameter /resend/api-key instead.
RK_RESEND_API_KEY=
# Must be on a domain verified in Resend, or the API refuses the send — which looks
# exactly like a broken login.
RK_MAIL_FROM=rtp@mattrickslauer.com
RK_MAIL_FROM_NAME=Respect the Funk

# ---------------------------------------------------------------- backends
#
# Dev reads local disk; only the deployment reads B2. This is a cost boundary, not a
# preference: **B2's caps are per account, not per bucket**, so a laptop browsing the
# production bucket spends the same 2,500 daily Class B transactions the deployed app
# needs — and when they run out, every read 403s for everybody at once, including anyone
# you are showing the app to. A separate dev bucket would not help; a different backend
# does. The startup banner says so out loud if this is set to `b2` while RK_ENV=dev.
#
# Uncomment only to reproduce something that is specifically about B2.
# RK_STORAGE_BACKEND=b2
# RK_B2_BUCKET=
# RK_B2_KEY_ID=
# RK_B2_APP_KEY=
# RK_B2_REGION=

# RK_GENERATOR_BACKEND=genblaze
# Genblaze reads these unprefixed, straight from the environment.
# GMI_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
#
# Pin a vendor per modality: gmicloud | openai | google | elevenlabs. Empty is the
# preference order in adapters/providers.VENDOR_ORDER (GMI, then OpenAI, then Google;
# OpenAI ahead of Google because Vertex needs Application Default Credentials, which do
# not exist inside Lambda or a Fargate task).
#
# This exists so that moving a modality off a misbehaving provider is a deploy-time
# setting rather than a code change — on 2026-07-31 GMI's seedance-2 failed twice and
# billed for output it never produced, and video moved to Sora without an edit.
# RK_VIDEO_PROVIDER=openai
# RK_IMAGE_PROVIDER=
# RK_AUDIO_PROVIDER=
#
# Refuse any single run whose pre-flight estimate exceeds this, in cents. 0 disables it.
# Genblaze ships no spend guardrail of its own and a failed step is still a billed step,
# so this is the only thing standing between a bad brief and a surprise invoice. Prices
# come from adapters/pricing, which is registered into Genblaze's own ModelRegistry so
# the estimate and the ledger cannot disagree.
# RK_MAX_RUN_CENTS=500

# RK_QUEUE_BACKEND=sqs
# RK_SQS_QUEUE_URL=
# RK_BATCH_JOB_QUEUE=
# RK_BATCH_JOB_DEFINITION=

# Measuring an uploaded master — tempo, drop, sections. `auto` (the default) uses numpy if
# it is installed and refuses with the missing piece named if it is not; there is no mock,
# because a fabricated BPM is a float nothing downstream could tell from a real one.
#   pip install -e '.[audio]'     and ffmpeg on PATH for anything but a WAV
# `none` switches it off in a process that should not be doing DSP at all.
# RK_ANALYSIS_BACKEND=none
# RK_ANALYSIS_WINDOW_S=600

# ---------------------------------------------------------------- secrets from SSM
# Rather than pasting the keys above, name an SSM path and they are fetched at startup —
# the same mechanism production uses, so a laptop and a deployment read credentials the
# same way and there is no second code path to keep honest.
#
# RK_AWS_PROFILE matters on a laptop: without it boto3 falls back to `default`, and a
# stale default profile fails with an authentication error that never says which
# identity it tried. In a deployment leave it empty — the execution role has no profile.
# RK_SSM_PATH=/remixkit/prod
# RK_AWS_PROFILE=respect-the-funk
